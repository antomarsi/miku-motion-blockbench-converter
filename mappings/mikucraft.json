      "rest_correction": { "euler_deg": [0, 0, -53] }
    },
    "RightArm": {
      "from": ["上半身1", "上半身2", "上半身3", "右肩", "右腕"],
      "rest_correction": { "euler_deg": [0, 0, 53] }
    },
    "BottomRightArm": {
      "from": ["右腕捩", "右ひじ", "右手捩"],
      "rest_correction": { "euler_deg": [0, 0, 53] }
    },
    "LeftLeg": { "from": ["腰", "下半身", { "bone": "腰", "weight": -1 }, "左足"] },
    "BottomLeftLeg": "左ひざ",
    "RightLeg": { "from": ["腰", "下半身", { "bone": "腰", "weight": -1 }, "右足"] },
    "BottomRightLeg": "右ひざ"
  },
  "secondary_motion": [
    { "bones": ["Tt_right", "middle_right", "bottom_right"], "preset": "long_hair", "offset": [0, 0, 4] },
    { "bones": ["Tt_left", "middle_left", "bottom_left"], "preset": "long_hair", "offset": [0, 0, 4] }
  ],
  "morphs": [
    {"morph": ["まばたき", "笑い", "なごみ", "はぅ"], "bone": "Eyes", "scale": [1, 0.1, 1]},
    {"morph": ["ウィンク右", "ウィンク２右"], "bone": "RightEye", "scale": [1, 0.1, 1]},
    {"morph": ["ウィンク", "ウィンク２"], "bone": "LeftEye", "scale": [1, 0.1, 1]},
    {"morph": "あ", "bone": "Mouth", "scale": [1, 2.5, 1]},
    {"morph": "い", "bone": "Mouth", "scale": [1.4, 0.8, 1]},
    {"morph": "う", "bone": "Mouth", "scale": [0.7, 1.4, 1]},
    {"morph": "え", "bone": "Mouth", "scale": [1.2, 1.6, 1]},
    {"morph": "お", "bone": "Mouth", "scale": [0.9, 2.2, 1]}
  ]
