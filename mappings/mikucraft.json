    "Chest": { "from": ["上半身1", "上半身2"] },
    "Head": { "from": ["上半身1", "上半身2", "上半身3", "首", "頭"] },
    "LeftArm": {
      "from": ["上半身1", "上半身2", "上半身3", "左肩", "左腕"],
      "rest_correction": { "euler_deg": [0, 0, -53] }
    },
    "BottomLeftArm": {
