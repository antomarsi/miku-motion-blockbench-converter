# Real assets are NEVER committed (third-party motions and models, the user's models/textures).
# Put them under assets/.
/assets/
*.vmd
*.vpd
*.pmx
*.pmd
*.bbmodel
*.png
!/docs/**/*.png
# The template model and its skin are ours and meant to be shared.
!/templates/*.bbmodel
!/templates/*.png
# Reference dumps are synthetic: generated by tools/dump_reference.py on the python branch.
!/reference/**

# Conversion outputs produced while experimenting
/out/
*.animation.json
!/reference/**/*.animation.json
conversion-report*.json

# Node
node_modules/
dist/
*.tsbuildinfo
coverage/

# Python (the Python version lives on the `python` branch; these appear when switching)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
build/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Audio (music is third-party too)
*.ogg
*.mp3
*.wav
